@page
@model Ecommerce.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="auth-card card mx-auto">
        <!-- Brand Icon -->
        <div class="text-center mb-1">
            <div class="auth-brand-icon">
                <i class="bi bi-bag-heart-fill"></i>
            </div>
            <h3 class="fw-bold mb-0">Welcome back</h3>
            <p class="text-muted small">Sign in to your ShopEase account</p>
        </div>

        <!-- Social Login (UI Only) -->
        <div class="d-grid gap-2 mb-4">
            <button type="button" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2">
                <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.4 0 6.1 1.2 8.1 3.1l6-6C34.5 3.2 29.7 1 24 1 14.8 1 7 6.7 3.8 14.7l7 5.4C12.4 14.1 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.4C35.5 32 33 34.4 29.9 36l6.9 5.4C41.6 37.7 46.1 31.7 46.1 24.5z"/><path fill="#FBBC05" d="M10.8 28.1A14.5 14.5 0 0 1 9.5 24c0-1.4.2-2.8.6-4.1l-7-5.4A23.9 23.9 0 0 0 .1 24c0 3.9.9 7.5 2.5 10.8l8.2-6.7z"/><path fill="#34A853" d="M24 47c5.7 0 10.5-1.9 14-5.1l-6.9-5.4C29.2 38 26.7 38.9 24 38.9c-6.2 0-11.5-4.2-13.4-9.9l-8 6.2C6.7 42 14.8 47 24 47z"/></svg>
                Continue with Google
            </button>
        </div>

        <div class="position-relative text-center mb-4">
            <hr />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">
                or sign in with email
            </span>
        </div>

        <!-- Login Form -->
        <form method="post" id="loginForm" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold small"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Input.Email" class="form-control" placeholder="you@example.com"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label asp-for="Input.Password" class="form-label fw-semibold small"></label>
                    <a href="#" class="small text-primary">Forgot password?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Input.Password" class="form-control" id="passwordInput"
                           placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" id="togglePassword" tabindex="-1">
                        <i class="bi bi-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex align-items-center gap-2">
                <input asp-for="Input.RememberMe" class="form-check-input mt-0" type="checkbox" />
                <label asp-for="Input.RememberMe" class="form-check-label small">Remember me for 30 days</label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg fw-semibold" id="loginBtn">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="loginSpinner"></span>
                    Sign In
                </button>
            </div>

            <input type="hidden" asp-for="Input.ReturnUrl" />
        </form>

        <p class="text-center mt-4 mb-0 small">
            Don't have an account?
            <a asp-page="/Auth/Register" class="fw-semibold text-primary">Create one free</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle password visibility
        document.getElementById('togglePassword').addEventListener('click', () => {
            const inp  = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            const show = inp.type === 'password';
            inp.type   = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        // Show spinner on submit
        document.getElementById('loginForm').addEventListener('submit', function () {
            document.getElementById('loginSpinner').classList.remove('d-none');
            document.getElementById('loginBtn').disabled = true;
        });
    </script>
}
