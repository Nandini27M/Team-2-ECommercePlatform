@page
@model Ecommerce.Web.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Shopping Cart";
    var cart = Model.Cart;
}

<div class="container py-4">
    <h3 class="section-title mb-4">
        <i class="bi bi-cart3 me-2 text-primary"></i>
        Shopping Cart
        <span class="badge bg-primary ms-2 fs-6">@(cart?.TotalItems ?? 0)</span>
    </h3>

    @if (cart is null || !cart.Items.Any())
    {
        <!-- Empty Cart State -->
        <div class="empty-state">
            <i class="bi bi-cart-x"></i>
            <h4 class="mt-3 text-muted">Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added anything yet.</p>
            <a asp-page="/Products/Index" class="btn btn-primary px-4 mt-2">
                <i class="bi bi-grid me-2"></i>Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- ═══ CART ITEMS ═══ -->
            <div class="col-lg-8">
                <!-- Free shipping progress -->
                @if (!cart.IsFreeShipping)
                {
                    var progress = (double)cart.SubTotal / 500 * 100;
                    <div class="alert alert-info d-flex align-items-center gap-3 mb-3 py-2">
                        <i class="bi bi-truck fs-5"></i>
                        <div class="flex-grow-1">
                            <small>Add <strong>₹@((500 - cart.SubTotal).ToString("N0"))</strong> more for free shipping!</small>
                            <div class="progress mt-1" style="height:4px">
                                <div class="progress-bar bg-info" style="width:@progress%"></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success py-2">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <strong>You qualify for free shipping!</strong>
                    </div>
                }

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom cart-row"
                                 data-item-id="@item.CartItemId">
                                <!-- Product Image -->
                                <img src="@(item.ImageUrl ?? "/images/placeholder.jpg")"
                                     class="cart-item-img rounded-2 flex-shrink-0"
                                     alt="@item.ProductName" />

                                <!-- Product Info -->
                                <div class="flex-grow-1 min-w-0">
                                    <a asp-page="/Products/Detail" asp-route-id="@item.ProductId"
                                       class="text-decoration-none text-dark fw-semibold d-block text-truncate">
                                        @item.ProductName
                                    </a>
                                    <small class="text-muted">Unit Price: ₹@item.UnitPrice.ToString("N0")</small>
                                </div>

                                <!-- Quantity -->
                                <div class="qty-control input-group flex-shrink-0" style="max-width:120px">
                                    <button class="btn btn-outline-secondary btn-sm" type="button"
                                            onclick="updateQty(@item.CartItemId, -1, @item.UnitPrice)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input type="number" class="form-control form-control-sm text-center qty-field"
                                           value="@item.Quantity" min="1" max="@item.MaxQuantity"
                                           id="qty_@item.CartItemId"
                                           onchange="setQty(@item.CartItemId, this.value, @item.UnitPrice)" />
                                    <button class="btn btn-outline-secondary btn-sm" type="button"
                                            onclick="updateQty(@item.CartItemId, 1, @item.UnitPrice)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <!-- Item Total -->
                                <div class="text-end flex-shrink-0" style="min-width:90px">
                                    <div class="fw-bold text-primary item-total" id="total_@item.CartItemId">
                                        ₹@item.TotalPrice.ToString("N0")
                                    </div>
                                </div>

                                <!-- Remove -->
                                <button class="btn btn-link text-danger p-1 flex-shrink-0"
                                        onclick="removeItem(@item.CartItemId)"
                                        title="Remove">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        }

                        <!-- Cart Actions -->
                        <div class="d-flex justify-content-between align-items-center p-3">
                            <a asp-page="/Products/Index" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                            </a>
                            <button class="btn btn-outline-danger btn-sm" onclick="clearCart()">
                                <i class="bi bi-trash me-1"></i>Clear Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══ ORDER SUMMARY ═══ -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm position-sticky" style="top:76px">
                    <div class="card-header bg-primary text-white fw-semibold">
                        <i class="bi bi-receipt me-2"></i>Order Summary
                    </div>
                    <div class="card-body">
                        <!-- Coupon -->
                        <div class="input-group mb-3">
                            <input type="text" class="form-control form-control-sm"
                                   id="couponInput" placeholder="Coupon code" />
                            <button class="btn btn-outline-secondary btn-sm" onclick="applyCoupon()">
                                Apply
                            </button>
                        </div>

                        <!-- Totals -->
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Subtotal (@cart.TotalItems items)</span>
                            <span id="summarySubtotal">₹@cart.SubTotal.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Shipping</span>
                            <span class="@(cart.IsFreeShipping ? "text-success fw-semibold" : "")">
                                @(cart.IsFreeShipping ? "FREE" : $"₹{cart.ShippingCost:N0}")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-muted small">
                            <span>GST (18%)</span>
                            <span>₹@cart.Tax.ToString("N0")</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <span>Total</span>
                            <span class="text-primary" id="summaryTotal">₹@cart.Total.ToString("N0")</span>
                        </div>

                        <div class="d-grid">
                            <a asp-page="/Checkout/Index" class="btn btn-success btn-lg fw-semibold">
                                <i class="bi bi-lock-fill me-2"></i>Secure Checkout
                            </a>
                        </div>

                        <!-- Payment badges -->
                        <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                            <span class="badge bg-light text-dark border small">
                                <i class="bi bi-credit-card me-1 text-primary"></i>Cards
                            </span>
                            <span class="badge bg-light text-dark border small">UPI</span>
                            <span class="badge bg-light text-dark border small">Net Banking</span>
                            <span class="badge bg-light text-dark border small">COD</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    function updateQty(itemId, delta, unitPrice) {
        const inp = document.getElementById('qty_' + itemId);
        const newQty = Math.max(1, parseInt(inp.value) + delta);
        inp.value = newQty;
        saveQty(itemId, newQty, unitPrice);
    }

    function setQty(itemId, qty, unitPrice) {
        saveQty(itemId, Math.max(1, parseInt(qty)), unitPrice);
    }

    function saveQty(itemId, qty, unitPrice) {
        fetch(`/Cart/UpdateItem`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ cartItemId: itemId, quantity: qty })
        }).then(r => {
            if (r.ok) {
                document.getElementById('total_' + itemId).textContent =
                    '₹' + (qty * unitPrice).toLocaleString('en-IN');
                // Full reload to recalculate totals properly
                location.reload();
            }
        });
    }

    function removeItem(itemId) {
        if (!confirm('Remove this item?')) return;
        fetch(`/Cart/RemoveItem?itemId=${itemId}`, {
            method: 'DELETE',
            headers: { 'RequestVerificationToken': getToken() }
        }).then(r => { if (r.ok) location.reload(); });
    }

    function clearCart() {
        if (!confirm('Clear all items from cart?')) return;
        fetch('/Cart/Clear', {
            method: 'DELETE',
            headers: { 'RequestVerificationToken': getToken() }
        }).then(r => { if (r.ok) location.reload(); });
    }

    function applyCoupon() {
        const code = document.getElementById('couponInput').value.trim();
        if (!code) return;
        // TODO: call coupon API
        alert('Coupon functionality coming soon!');
    }
</script>
}
