@page "{id}"
@model Ecommerce.Web.Pages.Orders.DetailModel
@{
    ViewData["Title"] = $"Order #{Model.Order?.OrderId}";
    var o = Model.Order;
}

@if (o is null)
{
    <div class="container py-5 text-center">
        <i class="bi bi-exclamation-triangle display-1 text-warning"></i>
        <h3 class="mt-3">Order Not Found</h3>
        <a asp-page="/Orders/Index" class="btn btn-primary mt-2">Back to Orders</a>
    </div>
    return;
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <a asp-page="/Orders/Index" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left me-1"></i>All Orders
            </a>
            <h3 class="section-title mb-0">Order #@o.OrderId</h3>
            <small class="text-muted">Placed on @o.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</small>
        </div>
        <span class="badge @(GetStatusClass(o.Status)) px-3 py-2 rounded-pill fs-6">@o.Status</span>
    </div>

    <!-- ═══ Order Tracker ═══ -->
    @if (o.TrackingSteps.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body py-4">
                <div class="order-tracker">
                    @foreach (var step in o.TrackingSteps)
                    {
                        <div class="tracker-step @(step.IsCompleted ? "completed" : "") @(step == o.TrackingSteps.FirstOrDefault(s => !s.IsCompleted) ? "active" : "")">
                            <div class="tracker-dot">
                                @if (step.IsCompleted)
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle"></i>
                                }
                            </div>
                            <div class="small fw-semibold">@step.Label</div>
                            @if (step.CompletedAt.HasValue)
                            {
                                <div class="text-muted" style="font-size:.7rem">
                                    @step.CompletedAt.Value.ToString("dd MMM")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row g-4">

        <!-- ═══ Items ═══ -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header fw-semibold">
                    <i class="bi bi-bag me-2 text-primary"></i>Items Ordered
                </div>
                <div class="card-body p-0">
                    @foreach (var item in o.Items)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                            <img src="@(item.ImageUrl ?? "/images/placeholder.jpg")"
                                 class="rounded-2 flex-shrink-0"
                                 style="width:70px;height:70px;object-fit:cover"
                                 alt="@item.ProductName" />
                            <div class="flex-grow-1">
                                <a asp-page="/Products/Detail" asp-route-id="@item.ProductId"
                                   class="fw-semibold text-dark text-decoration-none">
                                    @item.ProductName
                                </a>
                                <div class="text-muted small">Qty: @item.Quantity × ₹@item.UnitPrice.ToString("N0")</div>
                            </div>
                            <div class="fw-bold text-primary">₹@item.TotalPrice.ToString("N0")</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="card border-0 shadow-sm">
                <div class="card-header fw-semibold">
                    <i class="bi bi-geo-alt me-2 text-primary"></i>Delivery Address
                </div>
                <div class="card-body">
                    <p class="mb-0">
                        <strong>@o.ShippingAddress.FullName</strong><br />
                        @o.ShippingAddress.AddressLine1
                        @if (!string.IsNullOrEmpty(o.ShippingAddress.AddressLine2))
                        {
                            <text>, @o.ShippingAddress.AddressLine2</text>
                        }
                        <br />
                        @o.ShippingAddress.City, @o.ShippingAddress.State – @o.ShippingAddress.Pincode<br />
                        <i class="bi bi-telephone me-1 text-muted"></i>@o.ShippingAddress.Phone
                    </p>
                </div>
            </div>
        </div>

        <!-- ═══ Price + Payment ═══ -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header fw-semibold">
                    <i class="bi bi-receipt me-2 text-primary"></i>Price Details
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2 text-muted small">
                        <span>Subtotal</span>
                        <span>₹@o.SubTotal.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted small">
                        <span>Shipping</span>
                        <span class="@(o.ShippingCost == 0 ? "text-success" : "")">
                            @(o.ShippingCost == 0 ? "FREE" : $"₹{o.ShippingCost:N0}")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted small">
                        <span>GST</span>
                        <span>₹@o.Tax.ToString("N0")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total Paid</span>
                        <span class="text-primary">₹@o.Total.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <!-- Payment Method -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header fw-semibold">
                    <i class="bi bi-credit-card me-2 text-primary"></i>Payment
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>
                            <div class="fw-semibold small">@o.PaymentMethod</div>
                            <div class="text-muted" style="font-size:.75rem">Payment Confirmed</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(o.TrackingNumber))
                    {
                        <div class="mt-3 p-2 bg-light rounded">
                            <div class="text-muted small">Tracking Number</div>
                            <div class="fw-semibold font-monospace">@o.TrackingNumber</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="d-grid gap-2">
                <button class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i>Print Invoice
                </button>
                @if (o.Status is "Pending" or "Processing")
                {
                    <button class="btn btn-outline-danger" onclick="cancelOrder('@o.OrderId')">
                        <i class="bi bi-x-circle me-2"></i>Cancel Order
                    </button>
                }
                @if (o.Status == "Delivered")
                {
                    <button class="btn btn-success">
                        <i class="bi bi-star me-2"></i>Write a Review
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusClass(string status) => status.ToLower() switch
    {
        "pending"    => "bg-warning text-dark",
        "processing" => "bg-info text-dark",
        "shipped"    => "bg-primary",
        "delivered"  => "bg-success",
        "cancelled"  => "bg-danger",
        _            => "bg-secondary"
    };
}

@section Scripts {
<script>
    function cancelOrder(orderId) {
        if (!confirm('Are you sure you want to cancel this order?')) return;
        fetch(`/Orders/Cancel?orderId=${orderId}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
        }).then(r => {
            if (r.ok) window.location.href = '/Orders';
        });
    }
</script>
}
