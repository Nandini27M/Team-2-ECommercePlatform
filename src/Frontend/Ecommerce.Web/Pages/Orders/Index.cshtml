@page
@model Ecommerce.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3 class="section-title mb-0">
            <i class="bi bi-box-seam me-2 text-primary"></i>My Orders
        </h3>

        <!-- Status Filter -->
        <div class="d-flex gap-2 flex-wrap">
            @foreach (var status in new[] { "", "Pending", "Processing", "Shipped", "Delivered", "Cancelled" })
            {
                <a asp-page="/Orders/Index" asp-route-filterStatus="@status"
                   class="btn btn-sm @(Model.Orders.FilterStatus == status ? "btn-primary" : "btn-outline-secondary")">
                    @(string.IsNullOrEmpty(status) ? "All" : status)
                </a>
            }
        </div>
    </div>

    @if (!Model.Orders.Orders.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bag-x"></i>
            <h4 class="mt-3 text-muted">No orders found</h4>
            <p class="text-muted small">
                @(string.IsNullOrEmpty(Model.Orders.FilterStatus)
                    ? "You haven't placed any orders yet."
                    : $"No {Model.Orders.FilterStatus} orders found.")
            </p>
            <a asp-page="/Products/Index" class="btn btn-primary mt-2">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model.Orders.Orders)
            {
                <div class="card border-0 shadow-sm order-card">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <!-- Order ID + Date -->
                            <div>
                                <h6 class="fw-bold mb-1">
                                    Order <span class="text-primary">#@order.OrderId</span>
                                </h6>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                </small>
                            </div>

                            <!-- Status Badge -->
                            <span class="badge @order.StatusBadgeClass px-3 py-2 rounded-pill fs-7">
                                @order.Status
                            </span>
                        </div>

                        <hr class="my-3" />

                        <div class="row g-3 align-items-center">
                            <!-- Order Stats -->
                            <div class="col-sm-6 col-md-8">
                                <div class="d-flex gap-4 flex-wrap">
                                    <div>
                                        <div class="text-muted small">Items</div>
                                        <div class="fw-semibold">@order.ItemCount</div>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Total</div>
                                        <div class="fw-bold text-primary">₹@order.TotalAmount.ToString("N0")</div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(order.TrackingNumber))
                                    {
                                        <div>
                                            <div class="text-muted small">Tracking</div>
                                            <div class="fw-semibold font-monospace small">@order.TrackingNumber</div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="col-sm-6 col-md-4 d-flex gap-2 justify-content-sm-end flex-wrap">
                                <a asp-page="/Orders/Detail" asp-route-id="@order.OrderId"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>

                                @if (order.Status == "Pending" || order.Status == "Processing")
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            onclick="cancelOrder('@order.OrderId')">
                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                    </button>
                                }

                                @if (order.Status == "Delivered")
                                {
                                    <button class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-arrow-repeat me-1"></i>Reorder
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.Orders.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.Orders.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Orders.Page ? "active" : "")">
                            <a class="page-link" asp-page="/Orders/Index"
                               asp-route-page="@i"
                               asp-route-filterStatus="@Model.Orders.FilterStatus">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

<!-- Confirm Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-bold">Cancel Order?</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-muted small">
                Are you sure you want to cancel this order? This action cannot be undone.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">No, Keep It</button>
                <button type="button" class="btn btn-danger btn-sm" id="confirmCancelBtn">Yes, Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cancelOrderId = null;
    const cancelModal = new bootstrap.Modal(document.getElementById('cancelModal'));

    function cancelOrder(orderId) {
        cancelOrderId = orderId;
        cancelModal.show();
    }

    document.getElementById('confirmCancelBtn').addEventListener('click', async () => {
        if (!cancelOrderId) return;
        const res = await fetch(`/Orders/Cancel?orderId=${cancelOrderId}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getToken() }
        });
        cancelModal.hide();
        if (res.ok) location.reload();
        else alert('Failed to cancel order. Please try again.');
    });

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
</script>
}
