@page
@model Ecommerce.Web.Pages.Products.DetailModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Product Detail";
    var p = Model.Product;
}

@if (p is null)
{
    <div class="container py-5 text-center">
        <i class="bi bi-exclamation-triangle display-1 text-warning"></i>
        <h3 class="mt-3">Product Not Found</h3>
        <a asp-page="/Products/Index" class="btn btn-primary mt-2">Back to Products</a>
    </div>
    return;
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="/Products/Index">Products</a></li>
            <li class="breadcrumb-item">
                <a asp-page="/Products/Index" asp-route-categoryId="@p.CategoryId">@p.CategoryName</a>
            </li>
            <li class="breadcrumb-item active">@p.Name</li>
        </ol>
    </nav>

    <!-- ═══ MAIN PRODUCT SECTION ═══ -->
    <div class="row g-5">

        <!-- Image Gallery -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm overflow-hidden rounded-3">
                <img id="mainImg"
                     src="@(p.ImageUrl ?? "/images/placeholder.jpg")"
                     class="w-100" style="height:400px;object-fit:cover" alt="@p.Name" />
            </div>
            @if (p.ImageGallery.Any())
            {
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    @foreach (var img in p.ImageGallery)
                    {
                        <img src="@img" class="rounded-2 border border-2 gallery-thumb"
                             style="width:72px;height:72px;object-fit:cover;cursor:pointer"
                             onclick="document.getElementById('mainImg').src='@img'" alt="thumbnail" />
                    }
                </div>
            }
        </div>

        <!-- Product Info -->
        <div class="col-md-7">
            <span class="badge bg-primary-subtle text-primary mb-2">@p.CategoryName</span>
            <h2 class="fw-bold">@p.Name</h2>

            <!-- Rating -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="stars fs-5">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= (int)p.Rating ? "bi-star-fill" : (i - 0.5 <= p.Rating ? "bi-star-half" : "bi-star"))"></i>
                    }
                </div>
                <span class="fw-semibold">@p.Rating.ToString("F1")</span>
                <span class="text-muted small">(@p.ReviewCount reviews)</span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <span class="display-6 fw-bold text-primary">₹@p.Price.ToString("N0")</span>
                <span class="text-muted ms-2 small">Inclusive of all taxes</span>
            </div>

            <!-- Stock Status -->
            <div class="mb-4">
                @if (!p.IsInStock)
                {
                    <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>
                }
                else if (p.IsLowStock)
                {
                    <span class="badge bg-warning text-dark fs-6">
                        <i class="bi bi-exclamation-triangle me-1"></i>Only @p.StockQuantity left!
                    </span>
                }
                else
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>In Stock</span>
                }
            </div>

            <!-- Description -->
            <p class="text-muted mb-4">@p.Description</p>

            <!-- Quantity + Buttons -->
            @if (p.IsInStock)
            {
                <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                    <div class="qty-control input-group" style="max-width:130px">
                        <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">
                            <i class="bi bi-dash"></i>
                        </button>
                        <input type="number" id="qtyInput" class="form-control text-center"
                               value="1" min="1" max="@p.StockQuantity" />
                        <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>

                    <button class="btn btn-primary btn-lg flex-grow-1"
                            onclick="addToCartDetail(@p.ProductId)" id="addCartBtn">
                        <i class="bi bi-cart-plus me-2"></i>Add to Cart
                    </button>

                    <a asp-page="/Checkout/Index" class="btn btn-warning btn-lg px-4">
                        Buy Now
                    </a>
                </div>
            }

            <!-- Delivery Info -->
            <div class="card bg-light border-0 p-3 mb-4">
                <div class="row text-center g-3">
                    <div class="col-4">
                        <i class="bi bi-truck fs-4 text-primary"></i>
                        <div class="small mt-1">Free Delivery<br><span class="text-muted" style="font-size:.75rem">Orders ₹500+</span></div>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-arrow-return-left fs-4 text-success"></i>
                        <div class="small mt-1">Easy Returns<br><span class="text-muted" style="font-size:.75rem">7 days</span></div>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-shield-check fs-4 text-warning"></i>
                        <div class="small mt-1">Warranty<br><span class="text-muted" style="font-size:.75rem">1 year</span></div>
                    </div>
                </div>
            </div>

            <!-- Specifications -->
            @if (p.Specifications.Any())
            {
                <h6 class="fw-bold mb-2">Specifications</h6>
                <table class="table table-sm table-striped rounded-2 overflow-hidden">
                    <tbody>
                        @foreach (var spec in p.Specifications)
                        {
                            <tr>
                                <td class="fw-semibold text-muted w-40">@spec.Key</td>
                                <td>@spec.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- ═══ REVIEWS ═══ -->
    <div class="mt-5">
        <h4 class="section-title mb-4">Customer Reviews</h4>

        @if (!p.Reviews.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-chat-square-text display-5"></i>
                <p class="mt-2">No reviews yet. Be the first to review!</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var r in p.Reviews)
                {
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="avatar-circle bg-primary text-white" style="width:38px;height:38px">
                                        @r.ReviewerName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-semibold small">@r.ReviewerName</div>
                                        <div class="stars" style="font-size:.75rem">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <small class="text-muted">@r.ReviewDate.ToString("MMM dd, yyyy")</small>
                            </div>
                            <p class="mb-0 mt-2 small text-muted">@r.Comment</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ═══ RELATED PRODUCTS ═══ -->
    @if (p.RelatedProducts.Any())
    {
        <div class="mt-5">
            <h4 class="section-title mb-4">You May Also Like</h4>
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var rel in p.RelatedProducts)
                {
                    <div class="col">
                        <div class="card product-card h-100"
                             onclick="window.location='/Products/Detail?id=@rel.ProductId'">
                            <img src="@(rel.ImageUrl ?? "/images/placeholder.jpg")"
                                 class="card-img-top" style="height:160px;object-fit:cover" alt="@rel.Name" />
                            <div class="card-body p-2">
                                <h6 class="card-title small fw-semibold mb-1">@rel.Name</h6>
                                <div class="price-tag small">₹@rel.Price.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Cart Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:11">
    <div id="cartToast" class="toast text-bg-success border-0">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>Added to cart!</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function changeQty(delta) {
        const inp = document.getElementById('qtyInput');
        const max = parseInt(inp.max);
        inp.value = Math.max(1, Math.min(max, parseInt(inp.value) + delta));
    }

    function addToCartDetail(productId) {
        const qty = parseInt(document.getElementById('qtyInput').value);
        fetch('/Cart/AddItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ productId, quantity: qty })
        }).then(r => {
            if (r.ok) {
                const toast = new bootstrap.Toast(document.getElementById('cartToast'));
                toast.show();
            }
        });
    }

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
</script>
}
