@page
@model Ecommerce.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid py-4">
    <div class="row g-4">

        <!-- ═══════ SIDEBAR FILTERS ═══════ -->
        <div class="col-lg-3 col-xl-2 filter-sidebar">
            <div class="card p-3 mb-3 position-sticky" style="top:76px">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-funnel me-2 text-primary"></i>Filters
                    @if (!string.IsNullOrEmpty(Model.Filter.SearchQuery) || Model.Filter.SelectedCategoryId.HasValue)
                    {
                        <a asp-page="/Products/Index" class="btn btn-sm btn-outline-secondary ms-auto float-end py-0">
                            Clear all
                        </a>
                    }
                </h6>

                <form method="get" id="filterForm">
                    <!-- Search -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Search</label>
                        <input type="text" name="search" class="form-control form-control-sm"
                               value="@Model.Filter.SearchQuery" placeholder="Search..." />
                    </div>

                    <!-- Categories -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category</label>
                        @foreach (var cat in Model.Filter.Categories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryId"
                                       id="cat@(cat.CategoryId)" value="@cat.CategoryId"
                                       @(Model.Filter.SelectedCategoryId == cat.CategoryId ? "checked" : "")
                                       onchange="document.getElementById('filterForm').submit()" />
                                <label class="form-check-label small" for="cat@(cat.CategoryId)">
                                    @cat.Name
                                    <span class="text-muted">(@cat.ProductCount)</span>
                                </label>
                            </div>
                        }
                    </div>

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Price Range</label>
                        <input type="range" class="form-range" id="priceRange"
                               min="0" max="10000" step="100"
                               value="@(Model.Filter.MaxPrice ?? 10000)"
                               oninput="document.getElementById('priceVal').textContent='₹'+this.value" />
                        <div class="range-labels">
                            <span>₹0</span>
                            <span id="priceVal">₹@(Model.Filter.MaxPrice ?? 10000)</span>
                        </div>
                        <input type="hidden" name="maxPrice" id="maxPriceHidden"
                               value="@(Model.Filter.MaxPrice ?? 10000)" />
                    </div>

                    @* <!-- Sort -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sort By</label>
                        <select name="sort" class="form-select form-select-sm"
                                onchange="document.getElementById('filterForm').submit()">
                            <option value="name"       @(Model.Filter.SortBy=="name"?"selected":"")>Name A–Z</option>
                            <option value="name_desc"  @(Model.Filter.SortBy=="name_desc"?"selected":"")>Name Z–A</option>
                            <option value="price_asc"  @(Model.Filter.SortBy=="price_asc"?"selected":"")>Price: Low → High</option>
                            <option value="price_desc" @(Model.Filter.SortBy=="price_desc"?"selected":"")>Price: High → Low</option>
                            <option value="rating"     @(Model.Filter.SortBy=="rating"?"selected":"")>Top Rated</option>
                        </select>
                    </div> *@

                    <!-- Sort -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sort By</label>
                        <select name="sort" class="form-select form-select-sm"
                                onchange="document.getElementById('filterForm').submit()">
                            <option value="name" selected="@(Model.Filter.SortBy == "name")">Name A–Z</option>
                            <option value="name_desc" selected="@(Model.Filter.SortBy == "name_desc")">Name Z–A</option>
                            <option value="price_asc" selected="@(Model.Filter.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(Model.Filter.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="rating" selected="@(Model.Filter.SortBy == "rating")">Top Rated</option>
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-sm"
                                onclick="syncPrice()">Apply Filters</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ═══════ PRODUCT GRID ═══════ -->
        <div class="col-lg-9 col-xl-10">

            <!-- Header Row -->
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="section-title mb-1">
                        @(string.IsNullOrEmpty(Model.Filter.SearchQuery) ? "All Products" : $"Results for \"{Model.Filter.SearchQuery}\"")
                    </h4>
                    <small class="text-muted">@Model.Filter.TotalCount products found</small>
                </div>
                <!-- View toggle -->
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-secondary btn-sm active" id="gridViewBtn" onclick="setView('grid')">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" id="listViewBtn" onclick="setView('list')">
                        <i class="bi bi-list-ul"></i>
                    </button>
                </div>
            </div>

            @if (!Model.Filter.Products.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-search d-block"></i>
                    <h5 class="mt-3 text-muted">No products found</h5>
                    <p class="text-muted small">Try adjusting your search or filters.</p>
                    <a asp-page="/Products/Index" class="btn btn-outline-primary">Clear Filters</a>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3" id="productGrid">
                    @foreach (var p in Model.Filter.Products)
                    {
                        <div class="col product-col">
                            <div class="card product-card h-100"
                                 onclick="window.location='/Products/Detail?id=@p.ProductId'">
                                <div class="position-relative">
                                    <img src="@(p.ImageUrl ?? "/images/placeholder.jpg")"
                                         class="card-img-top" alt="@p.Name" loading="lazy" />
                                    <span class="badge-overlay">
                                        @if (!p.IsInStock)
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                        else if (p.IsLowStock)
                                        {
                                            <span class="badge bg-warning text-dark">Only @p.StockQuantity left</span>
                                        }
                                    </span>
                                    <button class="wishlist-btn" onclick="event.stopPropagation(); toggleWishlist(@p.ProductId, this)" title="Add to wishlist">
                                        <i class="bi bi-heart text-danger"></i>
                                    </button>
                                </div>
                                <div class="card-body d-flex flex-column p-3">
                                    <small class="text-muted text-uppercase fw-semibold" style="font-size:.7rem;letter-spacing:.05em">
                                        @p.CategoryName
                                    </small>
                                    <h6 class="card-title mb-1 mt-1 fw-semibold" style="font-size:.9rem;line-height:1.3">
                                        @p.Name
                                    </h6>
                                    <div class="stars mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= (int)p.Rating ? "bi-star-fill" : (i - 0.5 <= p.Rating ? "bi-star-half" : "bi-star"))"></i>
                                        }
                                        <small class="text-muted ms-1">(@p.ReviewCount)</small>
                                    </div>
                                    <div class="mt-auto">
                                        <div class="price-tag">₹@p.Price.ToString("N0")</div>
                                        <button class="btn btn-primary btn-sm w-100 mt-2"
                                                onclick="event.stopPropagation(); addToCart(@p.ProductId)"
                                                @(p.IsInStock ? "" : "disabled")>
                                            <i class="bi bi-cart-plus me-1"></i>
                                            @(p.IsInStock ? "Add to Cart" : "Out of Stock")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- ─── Pagination ─── -->
                @if (Model.Filter.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Products pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.Filter.Page == 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="/Products/Index"
                                   asp-route-page="@(Model.Filter.Page - 1)"
                                   asp-route-search="@Model.Filter.SearchQuery"
                                   asp-route-categoryId="@Model.Filter.SelectedCategoryId">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.Filter.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Filter.Page ? "active" : "")">
                                    <a class="page-link" asp-page="/Products/Index"
                                       asp-route-page="@i"
                                       asp-route-search="@Model.Filter.SearchQuery"
                                       asp-route-categoryId="@Model.Filter.SelectedCategoryId">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.Filter.Page == Model.Filter.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="/Products/Index"
                                   asp-route-page="@(Model.Filter.Page + 1)"
                                   asp-route-search="@Model.Filter.SearchQuery"
                                   asp-route-categoryId="@Model.Filter.SelectedCategoryId">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:11">
    <div id="cartToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle me-2"></i>Added to cart!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function addToCart(productId) {
        fetch('/Cart/AddItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ productId, quantity: 1 })
        }).then(r => {
            if (r.ok) {
                const toast = new bootstrap.Toast(document.getElementById('cartToast'));
                toast.show();
                // Update badge count
                const badge = document.querySelector('.cart-count-badge');
                if (badge) badge.textContent = parseInt(badge.textContent || 0) + 1;
            }
        });
    }

    function toggleWishlist(id, btn) {
        const icon = btn.querySelector('i');
        icon.classList.toggle('bi-heart');
        icon.classList.toggle('bi-heart-fill');
    }

    function setView(mode) {
        const grid = document.getElementById('productGrid');
        if (mode === 'list') {
            grid.className = 'row row-cols-1 g-3';
            document.getElementById('gridViewBtn').classList.remove('active');
            document.getElementById('listViewBtn').classList.add('active');
        } else {
            grid.className = 'row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3';
            document.getElementById('listViewBtn').classList.remove('active');
            document.getElementById('gridViewBtn').classList.add('active');
        }
    }

    function syncPrice() {
        document.getElementById('maxPriceHidden').value =
            document.getElementById('priceRange').value;
    }

    document.getElementById('priceRange').addEventListener('change', syncPrice);

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
</script>
}
